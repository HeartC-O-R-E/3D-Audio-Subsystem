{
  "name": "3d-audio",
  "version": "1.0.0",
  "description": "3D positional audio for FiveM — arbitrary audio files spatialized through Web Audio / Howler.js",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeartC-O-R-E/3D-Audio-Subsystem.git"
  },
  "homepage": "https://heartc-o-r-e.github.io/3D-Audio-Subsystem/",
  "bugs": {
    "url": "https://github.com/HeartC-O-R-E/3D-Audio-Subsystem/issues"
  },
  "scripts": {
    "clean": "rimraf ./dist ./package",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "check:config": "node build/check-config-sync.js",
    "build:scripts": "node build/build-bundle.js",
    "build:web": "npm --prefix web run build",
    "build": "npm run clean && npm run typecheck && npm run check:config && npm run build:scripts && npm run build:web",
    "watch": "npm run clean && cross-env IS_WATCH_MODE=1 node build/build-bundle.js",
    "package": "node build/package.js",
    "dev:deploy": "node build/dev-deploy.js",
    "install:all": "npm ci && npm ci --prefix web",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build --strict"
  },
  "devDependencies": {
    "@citizenfx/client": "^2.0.6063-1",
    "@citizenfx/server": "^2.0.6063-1",
    "@types/node": "^20.10.5",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.1",
    "rimraf": "^5.0.1",
    "typescript": "^5.3.3"
  }
}
