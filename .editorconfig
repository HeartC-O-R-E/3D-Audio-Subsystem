root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{vue,ts,html}]
# The NUI project follows Vue's 2-space convention
indent_size = 2

[src/**/*.ts]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.lua]
indent_size = 4
